          valueFrom:
            secretKeyRef:
              key: authentication-jwt-secret
              name: redpanda-console
        - name: LICENSE
          valueFrom:
            secretKeyRef:
              key: license
              name: redpanda-console
        envFrom: []
        image: redpandadata/console-unstable:master-8a51854
        imagePullPolicy: IfNotPresent
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /admin/health
            port: http
          initialDelaySeconds: 0
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 1
        name: console
        ports:
