        image: docker.redpanda.com/redpandadata/redpanda-unstable:v25.1.1-rc5
        name: tuning
        resources: {}
        securityContext:
          capabilities:
            add:
            - SYS_RESOURCE
          privileged: true
          runAsGroup: 0
          runAsUser: 0
        volumeMounts:
