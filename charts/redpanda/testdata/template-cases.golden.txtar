        app.kubernetes.io/name: redpanda
    spec:
      automountServiceAccountToken: false
      containers:
      - command:
        - /redpanda-operator
        - sync-cluster-config
        - --users-directory
        - /etc/secrets/users
        - --redpanda-yaml
