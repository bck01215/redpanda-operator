        - mountPath: /etc/tls/certs/kafka-internal-0
          name: redpanda-kafka-internal-0-cert
        - mountPath: /etc/redpanda
          name: config
        - mountPath: /tmp/base-config
          name: base-config
        - mountPath: /var/lifecycle
          name: lifecycle-scripts
        - mountPath: /var/lib/redpanda/data
          name: datadir
      - args:
        - sidecar
        - --redpanda-yaml
