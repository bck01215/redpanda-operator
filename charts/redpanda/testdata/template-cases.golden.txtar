stringData:
  authentication-jwt-signingkey: SECRETKEY
  authentication-oidc-client-secret: ""
  kafka-sasl-aws-msk-iam-secret-key: ""
  kafka-sasl-password: ""
  kafka-tls-ca: ""
  kafka-tls-cert: ""
  kafka-tls-key: ""
  license: ${REDPANDA_SAMPLE_LICENSE}
