  strategy: {}
  template:
    metadata:
      annotations:
        checksum-redpanda-chart/config: 6167a97b9fcbdd25efff85e8a1fe3f02c6d081d909661cd287eba14de4309498
        checksum/config: a474215adda9df2c35fb051470c6ae790e594f8a2743c4716e720b132e848666
