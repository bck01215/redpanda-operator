        - containerPort: 8081
          name: schemaregistry
        - containerPort: 8084
          name: schema-default
        resources:
          limits:
            cpu: 1
            memory: 2.5Gi
        startupProbe:
          exec:
            command:
            - /bin/sh
            - -c
            - |
