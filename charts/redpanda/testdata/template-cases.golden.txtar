        env:
        - name: REDPANDA_LICENSE
          value: ATOTALLYVALIDLICENSE
        image: docker.redpanda.com/redpandadata/redpanda-operator:v2.3.8-24.3.6
        name: post-install
        resources: {}
        securityContext: {}
        volumeMounts:
