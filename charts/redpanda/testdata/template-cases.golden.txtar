  strategy: {}
  template:
    metadata:
      annotations:
        checksum-redpanda-chart/config: 8e46356471a066d063bee8d5c2fe2933b2288dfb1afd4effe9bcc87e9be609fe
        checksum/config: 0214c993fba155cffffb513f6e5d2508d1866df8e5b37f4d037a5e4c82007220
