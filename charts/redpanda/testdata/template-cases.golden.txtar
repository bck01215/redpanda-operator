      serviceAccountName: redpanda-console
      tolerations: []
      topologySpreadConstraints: []
      volumes:
      - configMap:
          name: redpanda-console
        name: configs
      - name: redpanda-default-cert
        secret:
          defaultMode: 272
          secretName: redpanda-default-cert
      - configMap:
          name: role-bindings-configmap
        name: role-bindings-volume
