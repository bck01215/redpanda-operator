          certFilepath: ""
          enabled: true
          insecureSkipTlsVerify: false
          keyFilepath: ""
        urls:
        - https://redpanda.default.svc.cluster.local.:9644
    schemaRegistry:
      enabled: true
      tls:
        caFilepath: /etc/tls/certs/default/ca.crt
        certFilepath: ""
        enabled: true
        insecureSkipTlsVerify: false
        keyFilepath: ""
