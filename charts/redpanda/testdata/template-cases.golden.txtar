  replicas: 3
  selector:
    matchLabels:
      app.kubernetes.io/component: not-redpanda-statefulset
      app.kubernetes.io/instance: redpanda
      app.kubernetes.io/name: not-redpanda
  serviceName: also-not-redpanda
  template:
    metadata:
      annotations:
        config.redpanda.com/checksum: a90b21628d89546d234075143f437a7118e87dca2eb009f7ffb653e7b8f09eca
      creationTimestamp: null
      labels:
        app.kubernetes.io/component: not-redpanda-statefulset
        app.kubernetes.io/instance: redpanda
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: not-redpanda
        helm.sh/chart: redpanda-5.9.20
        redpanda.com/poddisruptionbudget: also-not-redpanda
    spec:
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
          - labelSelector:
              matchLabels:
                app.kubernetes.io/component: not-redpanda-statefulset
                app.kubernetes.io/instance: redpanda
                app.kubernetes.io/name: not-redpanda
            topologyKey: kubernetes.io/hostname
      automountServiceAccountToken: false
      containers:
      - command:
        - rpk
        - redpanda
        - start
        - --advertise-rpc-addr=$(SERVICE_NAME).also-not-redpanda.default.svc.cluster.local.:33145
        env:
        - name: SERVICE_NAME
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        - name: POD_IP
          valueFrom:
            fieldRef:
              fieldPath: status.podIP
        - name: HOST_IP
          valueFrom:
            fieldRef:
              fieldPath: status.hostIP
        image: docker.redpanda.com/redpandadata/redpanda-unstable:v25.1.1-rc5
        lifecycle:
          postStart:
            exec:
              command:
              - bash
              - -c
              - 'timeout -v 45 bash -x /var/lifecycle/postStart.sh 2>&1 | sed "s/^/lifecycle-hook
                post-start $(date): /" | tee /proc/1/fd/1; true'
          preStop:
            exec:
              command:
              - bash
              - -c
              - 'timeout -v 45 bash -x /var/lifecycle/preStop.sh 2>&1 | sed "s/^/lifecycle-hook
                pre-stop $(date): /" | tee /proc/1/fd/1; true'
        livenessProbe:
          exec:
            command:
            - /bin/sh
            - -c
            - curl --silent --fail -k -m 5 --cacert /etc/tls/certs/default/ca.crt
              "https://${SERVICE_NAME}.also-not-redpanda.default.svc.cluster.local.:9644/v1/status/ready"
          failureThreshold: 3
          initialDelaySeconds: 10
          periodSeconds: 10
        name: redpanda
        ports:
        - containerPort: 9644
          name: admin
        - containerPort: 9645
          name: admin-default
        - containerPort: 8082
          name: http
        - containerPort: 8083
          name: http-default
        - containerPort: 9093
          name: kafka
        - containerPort: 9094
          name: kafka-default
        - containerPort: 33145
          name: rpc
        - containerPort: 8081
          name: schemaregistry
        - containerPort: 8084
          name: schema-default
        resources:
          limits:
            cpu: 1
            memory: 2.5Gi
        startupProbe:
          exec:
            command:
            - /bin/sh
            - -c
            - |
              set -e
              RESULT=$(curl --silent --fail -k -m 5 --cacert /etc/tls/certs/default/ca.crt "https://${SERVICE_NAME}.also-not-redpanda.default.svc.cluster.local.:9644/v1/status/ready")
              echo $RESULT
              echo $RESULT | grep ready
          failureThreshold: 120
          initialDelaySeconds: 1
          periodSeconds: 10
        volumeMounts:
        - mountPath: /etc/tls/certs/default
          name: redpanda-default-cert
        - mountPath: /etc/tls/certs/external
          name: redpanda-external-cert
        - mountPath: /etc/redpanda
          name: config
        - mountPath: /tmp/base-config
          name: base-config
        - mountPath: /var/lifecycle
          name: lifecycle-scripts
        - mountPath: /var/lib/redpanda/data
          name: datadir
      - args:
        - sidecar
        - --redpanda-yaml
        - /etc/redpanda/redpanda.yaml
        - --redpanda-cluster-namespace
        - default
        - --redpanda-cluster-name
        - also-not-redpanda
        - --run-broker-probe
        - --broker-probe-broker-url
        - $(SERVICE_NAME).also-not-redpanda.default.svc.cluster.local.:9644
        command:
        - /redpanda-operator
        env:
        - name: SERVICE_NAME
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        - name: POD_IP
          valueFrom:
            fieldRef:
