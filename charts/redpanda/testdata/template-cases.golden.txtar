apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  creationTimestamp: null
  labels:
    app.kubernetes.io/component: not-redpanda
    app.kubernetes.io/instance: redpanda
    app.kubernetes.io/managed-by: Helm
