      - cert_file: /etc/tls/certs/letsencrypt/tls.crt
        enabled: true
        key_file: /etc/tls/certs/letsencrypt/tls.key
        name: kafka-api-0
        require_client_auth: false
        truststore_file: /etc/ssl/certs/ca-certificates.crt
      rpc_server:
